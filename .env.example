# Salin ke .env.local untuk dev lokal. Di Vercel: Project Settings > Environment Variables.
# JANGAN pakai awalan VITE_ (nilainya akan ikut terkirim ke browser).

# Akun login PPIC (aplikasi ini hanya untuk PPIC). Boleh lebih dari satu akun.
APP_USERS=[{"username":"ppic","password":"GANTI_PASSWORD"}]

# Kunci penanda login: isi teks acak panjang (minimal 32 karakter)
AUTH_SECRET=GANTI_DENGAN_TEKS_ACAK_PANJANG

# Database Postgres (Neon). Di Vercel terisi otomatis saat Neon dihubungkan ke project.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Untuk cron pembersihan harian (isi teks acak). Opsional zona waktu: APP_TZ=Asia/Jakarta
CRON_SECRET=GANTI_DENGAN_TEKS_ACAK
